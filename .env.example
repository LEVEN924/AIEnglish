# Copy this file to .env.local and replace the values for your local account.
APP_USER=LEVEN
APP_PASSWORD_SALT=replace-with-hex-salt
APP_PASSWORD_HASH=replace-with-scrypt-hex-hash
PORT=4173

# Optional cloud capabilities. Without a key the app uses its tested local fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Local HTTPS is enabled automatically after `npm run https:setup`.
HTTPS_ENABLED=true
HTTPS_PORT=4174
# Override only when using certificates stored elsewhere.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
