# Copy this file to .env.local and replace only local secrets.
APP_USER=LEVEN
APP_PASSWORD_SALT=replace-with-hex-salt
APP_PASSWORD_HASH=replace-with-scrypt-hex-hash
PORT=4173

# Tencent Cloud is the only cloud provider used by AIEnglish.
# Create an API key in Tencent Cloud CAM, then enable TTS, ASR and SOE-N.
TENCENTCLOUD_APP_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou

# English TTS / ASR and strict adult oral assessment defaults.
TENCENT_TTS_VOICE_TYPE=101050
TENCENT_TTS_MODEL_TYPE=1
TENCENT_ASR_ENGINE=16k_en
TENCENT_SOE_SCORE_COEFF=4.0
# Shared SOE connection limit across users (1-8). Finished audio uses recording mode.
TENCENT_SOE_CONCURRENCY=4

# Optional: enable only after Tencent Machine Translation has been opened.
TENCENT_TMT_ENABLED=false

# Local HTTPS is enabled automatically after `npm run https:setup`.
HTTPS_ENABLED=true
HTTPS_PORT=4174
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
