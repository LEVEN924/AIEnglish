# Copy this file to .env.local and replace the values for your local account.
APP_USER=LEVEN
APP_PASSWORD_SALT=replace-with-hex-salt
APP_PASSWORD_HASH=replace-with-scrypt-hex-hash
PORT=4173

# Optional: both values are required to enable structured OpenAI grading.
# If omitted, the app uses its built-in explainable rubric scorer.
OPENAI_API_KEY=
OPENAI_MODEL=
