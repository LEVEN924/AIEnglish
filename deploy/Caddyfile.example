# Replace learn.example.com with a domain you control and point DNS to this host.
# Caddy obtains and renews a publicly trusted TLS certificate.
learn.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:4173
    log {
        output file ./logs/access.log {
            roll_size 10MiB
            roll_keep 5
        }
    }
}
