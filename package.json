{
  "name": "ai-english",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/app.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/app.mjs",
    "test": "node --test tests/api.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:ui": "node --test tests/ui.test.mjs",
    "db:verify": "node --disable-warning=ExperimentalWarning scripts/database-maintenance.mjs verify",
    "db:backup": "node --disable-warning=ExperimentalWarning scripts/database-maintenance.mjs backup",
    "db:restore": "node --disable-warning=ExperimentalWarning scripts/database-maintenance.mjs restore",
    "https:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-https.ps1",
    "content:generate": "node scripts/crawl-vital-content.mjs",
    "content:generate:seed": "node scripts/expand-content.mjs",
    "content:validate": "node scripts/content-pipeline.mjs --quiet",
    "content:refresh": "node scripts/content-pipeline.mjs --fetch --quiet"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
